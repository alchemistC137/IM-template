    private sealed class CategoryFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre es obligatorio.")]
        [System.ComponentModel.DataAnnotations.MaxLength(150)]
        public string Name { get; set; } = string.Empty;

        public string ParentCategoryId { get; set; } = string.Empty;

        public bool IsActive { get; set; } = true;
    }

    private abstract class CommercialFormModel
    {
        [System.ComponentModel.DataAnnotations.MaxLength(50, ErrorMessage = "La unidad no puede superar 50 caracteres.")]
        public string? UnitOfMeasure { get; set; }

        [System.ComponentModel.DataAnnotations.Range(typeof(decimal), "0", "100", ErrorMessage = "El impuesto debe estar entre 0 y 100 %.")]
        public decimal? TaxRate { get; set; }

        [System.ComponentModel.DataAnnotations.MaxLength(200, ErrorMessage = "El proveedor no puede superar 200 caracteres.")]
        public string? Supplier { get; set; }
    }

    private sealed class ProductFormModel : CommercialFormModel
    {
        [System.ComponentModel.DataAnnotations.MaxLength(100, ErrorMessage = "La marca no puede superar 100 caracteres.")]
        public string? Brand { get; set; }

        [System.ComponentModel.DataAnnotations.Range(0, int.MaxValue, ErrorMessage = "El plazo de entrega no puede ser negativo.")]
        public int? DeliveryDays { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre es obligatorio.")]
        [System.ComponentModel.DataAnnotations.MaxLength(200)]
        public string Name { get; set; } = string.Empty;

        public string Description { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Range(0, double.MaxValue, ErrorMessage = "El precio no puede ser negativo.")]
        public decimal PriceAmount { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La moneda es obligatoria.")]
        [System.ComponentModel.DataAnnotations.StringLength(3, MinimumLength = 3, ErrorMessage = "Usa un código ISO de 3 letras.")]
        public string PriceCurrencyCode { get; set; } = "EUR";

        public string CategoryId { get; set; } = string.Empty;

        public string Sku { get; set; } = string.Empty;

        public bool IsActive { get; set; } = true;
    }

    private sealed class ServiceFormModel : CommercialFormModel
    {
