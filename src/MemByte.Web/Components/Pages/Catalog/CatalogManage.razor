                serviceForm.UnitOfMeasure, serviceForm.TaxRate, serviceForm.Supplier, serviceForm.Reference, serviceForm.DeliveryMode, serviceForm.BillingPeriod))
            : await CatalogService.UpdateServiceAsync(editingServiceId.Value, new UpdateServiceRequest(serviceForm.Name, serviceForm.Description,
                serviceForm.PriceAmount, serviceForm.PriceCurrencyCode, categoryId, serviceForm.DurationMinutes, serviceForm.IsRecurring, serviceForm.IsActive,
                serviceForm.UnitOfMeasure, serviceForm.TaxRate, serviceForm.Supplier, serviceForm.Reference, serviceForm.DeliveryMode, serviceForm.BillingPeriod));

        savingService = false;

        if (result.Succeeded)
