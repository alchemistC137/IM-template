@page "/membyte"
@using MemByte.Application.MemByteServices
@using MemByte.Infrastructure.Identity
@attribute [Authorize(Roles = ApplicationRoleNames.Admin)]
@inject IMemByteApiClient MemByteApi

<PageTitle>MemByte - @Intranet.Value.ApplicationName</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="bi bi-building text-primary fs-4" aria-hidden="true"></span>
            <h1 class="h4 mb-0">Servicios MemByte</h1>
        </div>
        <p class="text-muted mb-0">Resumen de productos, costes y soporte para @Intranet.Value.CompanyName.</p>
    </div>
    <span class="badge rounded-pill text-bg-light border px-3 py-2">
        <span class="bi bi-person-lock me-1" aria-hidden="true"></span>Acceso de administración
    </span>
</div>

@if (!MemByteApi.IsAvailable)
{
    <div class="alert alert-info d-flex gap-3 align-items-start mb-4" role="status">
        <span class="bi bi-info-circle-fill fs-5" aria-hidden="true"></span>
        <div>
            <strong>Vista de demostración</strong>
            <div>La integración con el API de MemByte aún no está disponible. No se consultan datos ni se envían solicitudes.</div>
            <div class="small mt-1">Todas las cifras y los registros de esta pantalla son datos de ejemplo; no representan costes, contratos ni incidencias reales.</div>
        </div>
    </div>
}

<section aria-label="Indicadores de ejemplo" class="mb-4">
    <div class="row g-3">
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small">Coste mensual estimado</div>
                        <div class="fs-4 fw-semibold mt-1">1.240 €</div>
                        <div class="text-muted small mt-1">Ejemplo · EUR / mes</div>
                    </div>
                    <span class="bi bi-currency-euro fs-4 text-primary bg-primary-subtle rounded p-2" aria-hidden="true"></span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small">Servicios activos</div>
                        <div class="fs-4 fw-semibold mt-1">4</div>
                        <div class="text-muted small mt-1">Registros de ejemplo</div>
                    </div>
                    <span class="bi bi-layers fs-4 text-success bg-success-subtle rounded p-2" aria-hidden="true"></span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small">Tickets abiertos</div>
                        <div class="fs-4 fw-semibold mt-1">2</div>
                        <div class="text-muted small mt-1">Registros de ejemplo</div>
                    </div>
                    <span class="bi bi-headset fs-4 text-warning bg-warning-subtle rounded p-2" aria-hidden="true"></span>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-start">
                    <div>
                        <div class="text-muted small">Solicitudes pendientes</div>
                        <div class="fs-4 fw-semibold mt-1">1</div>
                        <div class="text-muted small mt-1">Registros de ejemplo</div>
                    </div>
                    <span class="bi bi-hourglass-split fs-4 text-info bg-info-subtle rounded p-2" aria-hidden="true"></span>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="row g-3 mb-4">
    <section class="col-lg-8" aria-labelledby="membyte-cost-chart-title">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <h2 id="membyte-cost-chart-title" class="h6 mb-1">Evolución del coste mensual</h2>
                        <p class="text-muted small mb-0">Ejemplo ilustrativo · últimos seis meses · EUR</p>
                    </div>
                    <span class="badge text-bg-light border">Datos de ejemplo</span>
                </div>
                <div class="table-responsive">
                    <svg class="w-100" viewBox="0 0 720 300" role="img" aria-labelledby="membyte-chart-svg-title membyte-chart-svg-desc">
                        <title id="membyte-chart-svg-title">Evolución ilustrativa de costes de MemByte</title>
                        <desc id="membyte-chart-svg-desc">Gráfica de ejemplo con costes mensuales ascendentes de enero a junio, entre 890 y 1.240 euros. No son datos reales.</desc>
                        <g stroke="#e9ecef" stroke-width="1">
                            <line x1="78" y1="48" x2="700" y2="48" />
                            <line x1="78" y1="96" x2="700" y2="96" />
                            <line x1="78" y1="144" x2="700" y2="144" />
                            <line x1="78" y1="192" x2="700" y2="192" />
                            <line x1="78" y1="240" x2="700" y2="240" />
                        </g>
                        <g fill="#6c757d" font-size="12" text-anchor="end">
                            <text x="68" y="52">1.600 €</text>
                            <text x="68" y="100">1.200 €</text>
                            <text x="68" y="148">800 €</text>
                            <text x="68" y="196">400 €</text>
                            <text x="68" y="244">0 €</text>
                        </g>
                        <path d="M 90 133 L 205 129 L 320 122 L 435 122 L 550 105 L 665 91 L 665 240 L 90 240 Z" fill="#0d6efd" opacity="0.08" />
                        <polyline points="90,133 205,129 320,122 435,122 550,105 665,91" fill="none" stroke="#0d6efd" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                        <g fill="#fff" stroke="#0d6efd" stroke-width="3">
                            <circle cx="90" cy="133" r="5" />
                            <circle cx="205" cy="129" r="5" />
                            <circle cx="320" cy="122" r="5" />
                            <circle cx="435" cy="122" r="5" />
                            <circle cx="550" cy="105" r="5" />
                            <circle cx="665" cy="91" r="5" />
                        </g>
                        <g fill="#495057" font-size="12" text-anchor="middle">
                            <text x="90" y="119">890 €</text>
                            <text x="205" y="115">920 €</text>
                            <text x="320" y="108">980 €</text>
                            <text x="435" y="108">980 €</text>
                            <text x="550" y="91">1.120 €</text>
                            <text x="665" y="77">1.240 €</text>
                        </g>
                        <g fill="#6c757d" font-size="12" text-anchor="middle">
                            <text x="90" y="270">Ene</text>
                            <text x="205" y="270">Feb</text>
                            <text x="320" y="270">Mar</text>
                            <text x="435" y="270">Abr</text>
                            <text x="550" y="270">May</text>
                            <text x="665" y="270">Jun</text>
                        </g>
                    </svg>
                </div>
            </div>
        </div>
    </section>

    <section class="col-lg-4" aria-labelledby="membyte-support-summary-title">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 id="membyte-support-summary-title" class="h6 mb-0">Actividad de soporte</h2>
                    <span class="bi bi-headset text-primary" aria-hidden="true"></span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <div><div class="fw-medium">Incidencia de acceso</div><div class="text-muted small">Ejemplo · Prioridad alta</div></div>
                    <span class="badge text-bg-warning">En curso</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <div><div class="fw-medium">Consulta de configuración</div><div class="text-muted small">Ejemplo · Prioridad normal</div></div>
                    <span class="badge text-bg-info">Pendiente</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2">
                    <div><div class="fw-medium">Revisión de servicio</div><div class="text-muted small">Ejemplo · Cerrado</div></div>
                    <span class="badge text-bg-success">Resuelto</span>
                </div>
                <p class="text-muted small mb-0 mt-2">Los tickets reales estarán disponibles al integrar el API de MemByte.</p>
            </div>
        </div>
    </section>
</div>

<div class="row g-3">
    <section class="col-lg-7" aria-labelledby="membyte-contracts-title">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 id="membyte-contracts-title" class="h6 mb-0">Productos y servicios contratados</h2>
                    <span class="badge text-bg-light border">Ejemplo</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light"><tr><th>Servicio</th><th>Estado</th><th class="text-end">Importe mensual</th></tr></thead>
                        <tbody>
                            <tr><td><span class="fw-medium">Alojamiento cloud</span><div class="text-muted small">Ejemplo</div></td><td><span class="badge text-bg-success">Activo</span></td><td class="text-end">490 €</td></tr>
                            <tr><td><span class="fw-medium">Soporte gestionado</span><div class="text-muted small">Ejemplo</div></td><td><span class="badge text-bg-success">Activo</span></td><td class="text-end">350 €</td></tr>
                            <tr><td><span class="fw-medium">Mantenimiento web</span><div class="text-muted small">Ejemplo</div></td><td><span class="badge text-bg-success">Activo</span></td><td class="text-end">250 €</td></tr>
                            <tr><td><span class="fw-medium">Bolsa de horas</span><div class="text-muted small">Ejemplo</div></td><td><span class="badge text-bg-warning">Pendiente</span></td><td class="text-end">150 €</td></tr>
                        </tbody>
                        <tfoot><tr class="fw-semibold"><td colspan="2">Total mensual ilustrativo</td><td class="text-end">1.240 €</td></tr></tfoot>
                    </table>
                </div>
                <p class="text-muted small mb-0 mt-2">Importes ficticios de demostración; no son una oferta ni una factura.</p>
            </div>
        </div>
    </section>

    <section class="col-lg-5" aria-labelledby="membyte-requests-title">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 id="membyte-requests-title" class="h6 mb-0">Solicitudes recientes</h2>
                    <span class="badge text-bg-light border">Ejemplo</span>
                </div>
                <div class="d-flex gap-3 py-2 border-bottom">
                    <span class="bi bi-arrow-left-right text-primary mt-1" aria-hidden="true"></span>
                    <div class="flex-grow-1"><div class="fw-medium">Ampliación de almacenamiento</div><div class="text-muted small">Cambio · Ejemplo</div></div>
                    <span class="badge text-bg-warning align-self-start">En revisión</span>
                </div>
                <div class="d-flex gap-3 py-2">
                    <span class="bi bi-plus-circle text-success mt-1" aria-hidden="true"></span>
                    <div class="flex-grow-1"><div class="fw-medium">Alta de soporte gestionado</div><div class="text-muted small">Alta · Ejemplo</div></div>
                    <span class="badge text-bg-secondary align-self-start">Recibida</span>
                </div>
                <p class="text-muted small mb-0 mt-2">Podrás solicitar altas, cambios y bajas cuando esté disponible la integración.</p>
            </div>
        </div>
    </section>
</div>
